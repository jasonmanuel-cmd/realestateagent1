# Copy this file to .env and fill in the values.

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=

# Optional: where the digest email is sent. Defaults to the authenticated
# Gmail account's own address if left blank.
DIGEST_TO_EMAIL=

# --- Only needed if hosting api/digest.js on Vercel (see README "Hosting on
# Vercel"). Set these in Vercel's Project Settings -> Environment Variables,
# not here -- this .env file is for local runs of bin/run-digest.js, which
# uses credentials.json + token.json instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# CRON_SECRET=

# Copy this file to .env and fill in the values.

# --- Spreadsheet access, via the Apps Script Web App (apps-script/Code.gs)
# -- not the Google Sheets REST API. No Google Cloud Console, OAuth, or
# billing account involved. See README.md "One-time setup".
SHEETS_WEBAPP_URL=
SHEETS_WEBAPP_SECRET=

# --- Email, via Gmail SMTP + an App Password -- not the Gmail API. Turn on
# 2-Step Verification on your Google account, then generate an App
# Password at myaccount.google.com -> Security -> App Passwords.
SMTP_USER=
SMTP_APP_PASSWORD=

# Optional: where the digest email is sent. Defaults to SMTP_USER itself if
# left blank.
DIGEST_TO_EMAIL=

# --- Only needed if hosting api/digest.js on Vercel (see README "Hosting on
# Vercel"). Set this in Vercel's Project Settings -> Environment Variables,
# not here.
# CRON_SECRET=

# --- Only needed for the leads dashboard (index.html + api/login.js,
# api/logout.js, api/leads.js). Same note as above: set these in Vercel,
# not here.
# DASHBOARD_PASSWORD=
# SESSION_SECRET=
